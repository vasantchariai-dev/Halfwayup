---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Vertical dramas"
  description="Mobile-first short-form storytelling for the future of digital entertainment. Halfway Up Productions is pioneering quality vertical drama content in the UK."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="bg-primary text-white section-padding grain-texture">
      <div class="container-custom max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-serif font-bold mb-6">
          The future of storytelling is vertical
        </h1>
        <p class="text-xl md:text-2xl opacity-90">
          Mobile-first, bite-sized episodes designed for the way audiences actually watch content today.
        </p>
      </div>
    </section>

    <!-- What are Vertical Dramas -->
    <section class="section-padding bg-cream">
      <div class="container-custom max-w-4xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16">
          <div>
            <h2 class="text-3xl font-serif font-semibold mb-4">What are vertical dramas?</h2>
            <p class="text-lg mb-4">
              Vertical dramas are short-form series filmed in 9:16 aspect ratio, optimised for mobile viewing. Each episode runs 1-3 minutes, delivering complete narrative arcs in bite-sized instalments.
            </p>
            <p class="text-lg mb-4">
              This format has exploded globally through platforms like ReelShort and DramaBox, with audiences consuming hours of serialised content designed specifically for their phones.
            </p>
            <p class="text-lg text-muted">
              We're bringing this format to UK audiences with quality, union-friendly production and stories that matter.
            </p>
          </div>
          <div class="flex justify-center">
            <div class="relative w-64 h-[500px] bg-gray-900 rounded-3xl shadow-2xl overflow-hidden border-8 border-gray-800">
              <!-- Phone mockup -->
              <div class="absolute top-0 left-1/2 transform -translate-x-1/2 w-32 h-6 bg-gray-800 rounded-b-2xl"></div>
              <div class="w-full h-full bg-gradient-to-br from-secondary/20 to-accent/20 flex items-center justify-center">
                <div class="text-center text-white p-6">
                  <svg class="w-16 h-16 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <p class="text-sm font-mono">9:16 Format</p>
                  <p class="text-xs opacity-75 mt-1">1-3 min episodes</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Market Context -->
    <section class="section-padding bg-white">
      <div class="container-custom max-w-4xl">
        <h2 class="text-3xl font-serif font-semibold mb-8 text-center">Why vertical dramas matter</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="text-4xl font-serif font-bold text-secondary mb-2">$146m</div>
            <p class="text-sm font-mono text-muted mb-2">Q1 2024 Revenue</p>
            <p class="text-sm">ReelShort's quarterly earnings demonstrate massive appetite for vertical content</p>
          </div>
          <div class="text-center">
            <div class="text-4xl font-serif font-bold text-secondary mb-2">1-3 min</div>
            <p class="text-sm font-mono text-muted mb-2">Episode Length</p>
            <p class="text-sm">Perfectly calibrated for mobile attention spans and commute viewing</p>
          </div>
          <div class="text-center">
            <div class="text-4xl font-serif font-bold text-secondary mb-2">Global</div>
            <p class="text-sm font-mono text-muted mb-2">Market Reach</p>
            <p class="text-sm">Format transcends borders with universal emotional storytelling</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Approach -->
    <section class="section-padding bg-cream">
      <div class="container-custom max-w-4xl">
        <h2 class="text-3xl font-serif font-semibold mb-8">Our approach to vertical drama</h2>
        <div class="space-y-6">
          <div class="card p-6">
            <h3 class="text-xl font-serif font-semibold mb-2">Quality over quantity</h3>
            <p class="text-muted">
              We believe vertical drama can be more than viral content. Our productions prioritise emotional depth, strong character work, and cinematic craft—even at 1-2 minutes per episode.
            </p>
          </div>
          <div class="card p-6">
            <h3 class="text-xl font-serif font-semibold mb-2">Union-friendly production</h3>
            <p class="text-muted">
              Unlike many vertical content mills, we work with UK industry standards, proper crew rates, and equitable working conditions. Great stories come from supported teams.
            </p>
          </div>
          <div class="card p-6">
            <h3 class="text-xl font-serif font-semibold mb-2">UK-based talent</h3>
            <p class="text-muted">
              We're committed to developing British writers, directors, and actors for this emerging format—bringing fresh voices to a global platform.
            </p>
          </div>
          <div class="card p-6">
            <h3 class="text-xl font-serif font-semibold mb-2">Stories with heart, not just hooks</h3>
            <p class="text-muted">
              Yes, vertical drama needs compelling premises and cliffhangers. But we believe the format can also deliver meaningful themes, nuanced characters, and emotional truth.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section-padding bg-white">
      <div class="container-custom max-w-3xl text-center">
        <h2 class="text-3xl font-serif font-semibold mb-4">Interested in commissioning vertical content?</h2>
        <p class="text-lg text-muted mb-8">
          We're actively developing vertical drama series and would love to discuss co-production or commission opportunities.
        </p>
        <a href="/contact" class="btn-primary">
          Get in touch
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
