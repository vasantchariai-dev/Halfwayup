---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    title: "Notification",
    year: 2025,
    status: "In production" as const,
    type: "Short film",
    director: "TBC",
    logline: "A tense psychological drama exploring the anxiety and anticipation of waiting for life-changing news.",
    image: "/images/projects/notification-hero.jpg",
    slug: "notification"
  },
  {
    title: "New Shoes",
    year: 2024,
    status: "Completed" as const,
    type: "Short film",
    director: "TBC",
    logline: "A heartwarming story about finding confidence and identity through an unexpected purchase.",
    image: "/images/projects/new-shoes-hero.jpg",
    slug: "new-shoes"
  },
  {
    title: "Untitled Feature Project",
    year: 2025,
    status: "In development" as const,
    type: "Feature",
    logline: "A UK-India co-production exploring contemporary connections across cultures and continents.",
    image: "/images/projects/feature-development.jpg",
    slug: "untitled-feature"
  }
];
---

<BaseLayout title="Home">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="relative h-[70vh] md:h-[80vh] grain-texture overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary to-[#1a1f2e]">
        <!-- Placeholder for hero image - can be replaced with actual project still -->
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="relative h-full container-custom flex flex-col items-center justify-center text-center text-white">
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif font-bold mb-6 max-w-4xl">
          Halfway Up Productions
        </h1>
        <p class="text-xl md:text-2xl max-w-2xl font-light">
          Creating joyful, inclusive stories that reflect the world we want to live in.
        </p>
        <div class="mt-8 flex items-center">
          <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="section-padding bg-cream">
      <div class="container-custom">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-serif font-semibold mb-4">Featured projects</h2>
          <p class="text-lg text-muted max-w-2xl mx-auto">
            Discover our latest work in narrative filmmaking
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
          {featuredProjects.map(project => (
            <ProjectCard {...project} />
          ))}
        </div>

        <div class="text-center">
          <a href="/projects" class="btn-primary">
            View all projects
          </a>
        </div>
      </div>
    </section>

    <!-- USP Strip -->
    <section class="section-padding bg-white">
      <div class="container-custom">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Narrative Films -->
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-secondary/10 text-secondary mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
              </svg>
            </div>
            <h3 class="text-xl font-serif font-semibold mb-2">Narrative features & shorts</h3>
            <p class="text-muted">
              Emotionally resonant stories that connect audiences across borders
            </p>
          </div>

          <!-- Vertical Drama -->
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-secondary/10 text-secondary mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-serif font-semibold mb-2">Vertical drama pioneers</h3>
            <p class="text-muted">
              Mobile-first short-form content built for the future of storytelling
            </p>
          </div>

          <!-- UK-India Co-productions -->
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-secondary/10 text-secondary mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-serif font-semibold mb-2">UK-India co-productions</h3>
            <p class="text-muted">
              Leveraging bilateral treaties to tell cross-cultural stories
            </p>
          </div>
        </div>

        <!-- CTA Row -->
        <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/vertical-dramas" class="btn-secondary">
            Learn about vertical dramas
          </a>
          <a href="/co-productions" class="btn-secondary">
            Explore co-productions
          </a>
        </div>
      </div>
    </section>

    <!-- About Teaser -->
    <section class="section-padding bg-cream">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
            <div class="md:col-span-1">
              <div class="aspect-square rounded-lg bg-gray-300 overflow-hidden">
                <!-- Placeholder for Evelyn's photo -->
                <img
                  src="/images/team/evelyn-sharples.jpg"
                  alt="Evelyn Sharples"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="md:col-span-2">
              <h2 class="text-3xl font-serif font-semibold mb-4">About Halfway Up</h2>
              <p class="text-lg text-muted mb-4">
                Founded by producer Evelyn Sharples, Halfway Up Productions is an independent UK film production company dedicated to bringing underrepresented voices and emotionally truthful stories to screen.
              </p>
              <p class="text-lg text-muted mb-6">
                We believe in the power of cinema to create connection, challenge perspectives, and celebrate the human experience in all its diversity.
              </p>
              <a href="/about" class="btn-primary">
                Read our story
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
  }

  .animate-bounce {
    animation: bounce 2s ease-in-out infinite;
  }
</style>
