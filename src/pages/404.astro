---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist."
>
  <Header />

  <main>
    <section class="section-padding bg-cream min-h-[70vh] flex items-center">
      <div class="container-custom max-w-2xl text-center">
        <div class="mb-8">
          <svg
            class="w-32 h-32 mx-auto text-secondary opacity-20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>

        <h1 class="text-6xl md:text-7xl font-serif font-bold mb-4 text-primary">404</h1>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-4">Page not found</h2>
        <p class="text-lg text-muted mb-8">
          We couldn't find the page you're looking for. Perhaps it's still halfway up the mountain?
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn-primary">
            Go home
          </a>
          <a href="/projects" class="btn-secondary">
            View projects
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
